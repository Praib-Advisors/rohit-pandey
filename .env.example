# Public URL of the deployed site (canonical URLs, Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL=https://example.com

# Office contact shown on the site (optional): digits with country code, e.g. 919876543210
NEXT_PUBLIC_OFFICE_PHONE=
NEXT_PUBLIC_OFFICE_WHATSAPP=
NEXT_PUBLIC_OFFICE_EMAIL=

# Sections that are switched off for now. Set to true to bring them back.
NEXT_PUBLIC_SHOW_SOCIAL_SERVICE=false
# The "Public services" cards on the home page (the Greetings page stays in the menu).
NEXT_PUBLIC_SHOW_SERVICES=false
